<?xml version="1.0"?>
<sdf version="1.7">
    <xmacro_define_block name="swerve_wheel" params="prefix parent pose side">
        <joint name="${prefix}_mount_joint" type="fixed">
            <pose relative_to="${parent}">${pose}</pose>
            <parent>${parent}</parent>
            <child>${prefix}_mount</child>
        </joint>
        <link name="${prefix}_mount">
            <pose relative_to="${prefix}_mount_joint">0 0 0 0 0 0</pose>
            <inertial>
                <pose>0 ${-0.05*side} 0.12 0 0 0</pose>
                <xmacro_block name="inertia_box" m="0.2" x="0.055" y="0.15" z="0.025"/>
            </inertial>
            <visual name="mount_arm">
                <pose>0 ${-0.05*side} 0.12 0 0 0</pose>
                <xmacro_block name="geometry_box" x="0.055" y="0.15" z="0.025"/>
                <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.3 0.35 0.4 1</diffuse></material>
            </visual>
            <visual name="mount_support">
                <pose>0 ${-0.10*side} 0.06 0 0 0</pose>
                <xmacro_block name="geometry_box" x="0.055" y="0.02" z="0.10"/>
                <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.3 0.35 0.4 1</diffuse></material>
            </visual>
        </link>
        <joint name="${prefix}_steering_joint" type="revolute">
            <pose relative_to="${prefix}_mount">0 0 0 0 0 0</pose>
            <parent>${prefix}_mount</parent>
            <child>${prefix}_steering</child>
            <axis>
                <xyz>0 0 1</xyz>
                <limit><lower>-1e16</lower><upper>1e16</upper><effort>50</effort><velocity>8</velocity></limit>
                <dynamics><damping>0.1</damping></dynamics>
            </axis>
        </joint>
        <link name="${prefix}_steering">
            <pose relative_to="${prefix}_steering_joint">0 0 0 0 0 0</pose>
            <inertial>
                <pose>0 0 0.06 0 0 0</pose>
                <xmacro_block name="inertia_box" m="0.25" x="0.06" y="0.048" z="0.03"/>
            </inertial>
            <visual name="steering_motor">
                <pose>0 0 0.09 0 0 0</pose>
                <xmacro_block name="geometry_cylinder" r="0.028" l="0.035"/>
                <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.3 0.35 0.4 1</diffuse></material>
            </visual>
            <visual name="fork">
                <pose>0 0.022 0.035 0 0 0</pose>
                <xmacro_block name="geometry_box" x="0.035" y="0.008" z="0.09"/>
                <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
            </visual>
        </link>
        <joint name="${prefix}_wheel_joint" type="revolute">
            <parent>${prefix}_steering</parent>
            <child>${prefix}_wheel</child>
            <axis>
                <xyz>0 1 0</xyz>
                <limit><lower>-1e16</lower><upper>1e16</upper><effort>30</effort><velocity>100</velocity></limit>
            </axis>
        </joint>
        <link name="${prefix}_wheel">
            <pose relative_to="${prefix}_steering">0 0 0 0 0 0</pose>
            <inertial>
                <pose>0 0 0 1.5707963267948966 0 0</pose>
                <xmacro_block name="inertia_cylinder" m="0.4" r="0.0758" l="0.024"/>
            </inertial>
            <visual name="tire">
                <pose>0 0 0 1.5707963267948966 0 0</pose>
                <xmacro_block name="geometry_cylinder" r="0.0758" l="0.024"/>
                <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
            </visual>
            <visual name="hub">
                <pose>0 0 0 1.5707963267948966 0 0</pose>
                <xmacro_block name="geometry_cylinder" r="0.035" l="0.026"/>
                <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
            </visual>
            <collision name="tire">
                <pose>0 0 0 1.5707963267948966 0 0</pose>
                <xmacro_block name="geometry_cylinder" r="0.0758" l="0.024"/>
                <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
            </collision>
        </link>
    </xmacro_define_block>
</sdf>
