<?xml version='1.0' encoding='utf-8'?>
<sdf version='1.7'>
  <world name='default'>
    <!-- Physics -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>

    <!-- Forwards simulation state to the GUI -->
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- Processes user commands, like translate and create -->
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>

    <!-- Generates rendering sensor data -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
    </plugin>

    <light type='directional' name='direct_light'>
      <visualize>false</visualize>
      <cast_shadows>true</cast_shadows>
      <pose>14.6 7.9 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
    </light>

    <model name='rmuc_2027'>
      <include>
        <uri>model://rmuc_2027</uri>
      </include>
      <!-- Preserve native mesh size; align center to (14.5, 8) and
           ground at the rmuc25 spawn (3.4, 9.5) to z=0.2. -->
      <pose>0.350903146 -0.065353155 -0.080687477 0 0 0</pose>
      <static>true</static>
    </model>
    <!-- Same wall height as rmuc25; fitted outside the rmuc27 mesh bounds. -->
    <model name="rmuc_2027_perimeter_walls">
      <static>true</static>
      <link name="west_wall">
        <pose>0.472503226 8.000000000 9.407040000 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.055000000 16.113132343 18.695158000</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.055000000 16.113132343 18.695158000</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
      <link name="east_wall">
        <pose>28.527496774 8.000000000 9.407040000 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.055000000 16.113132343 18.695158000</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.055000000 16.113132343 18.695158000</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
      <link name="south_wall">
        <pose>14.500000000 -0.029066172 9.407040000 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>28.109993548 0.055000000 18.695158000</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>28.109993548 0.055000000 18.695158000</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
      <link name="north_wall">
        <pose>14.500000000 16.029066172 9.407040000 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>28.109993548 0.055000000 18.695158000</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>28.109993548 0.055000000 18.695158000</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
